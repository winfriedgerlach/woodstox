						<ns3:RemedyInfo />
					</ns3:CauseInfo>
					<ns3:MaxLimits Lower="0" Upper="10" />
				</ns3:AlertCondition>
				<ns3:AlertSignal
					ConditionSignaled="handle_limit_alert_condition"
					Handle="handle_alert_signal_latching" Latching="true"
					Manifestation="Vis">
					<ns2:Extension>
						<ns3:Type Code="MDCX_MY_TYPE" CodingSystem="11073" />
					</ns2:Extension>
					<ns3:Type Code="MDCX_CODE_ID_ALERT_NUMERIC_SIGNAL" />
				</ns3:AlertSignal>
			</ns3:AlertSystem>
			<ns3:Channel Handle="handle_chn">
