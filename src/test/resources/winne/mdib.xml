				Handle="patient_ctxt_sco" OperationTarget="h_patient_context"
				xsi:type="ns3:SetContextStateOperationDescriptor" />
			<ns3:Operation
				xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
				Handle="workflow_ctxt_sco" OperationTarget="h_workflow_context"
				xsi:type="ns3:SetContextStateOperationDescriptor" />
			<ns3:Operation
