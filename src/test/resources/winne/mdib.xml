					<ns3:Unit Code="MDCX_MY_UNIT" CodingSystem="11073" />
				</ns3:Metric>
				<ns3:Metric
					xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
					Handle="enum_string_met" MetricAvailability="Cont"
					MetricCategory="Set" xsi:type="ns3:EnumStringMetricDescriptor">
					<ns3:Type Code="MDCX_MY_TYPE" CodingSystem="11073" />
					<ns3:Unit Code="MDCX_MY_UNIT" CodingSystem="11073" />
					<ns3:AllowedValue><ns3:Value>Foo</ns3:Value></ns3:AllowedValue>
					<ns3:AllowedValue><ns3:Value>Bar</ns3:Value></ns3:AllowedValue>
				</ns3:Metric>
				<!-- <ns3:Metric xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
					Handle="handle_stream" MetricAvailability="Cont" MetricCategory="Msrmt" Resolution="1" 
					SamplePeriod="P0Y0M0DT0H0M0.010S" xsi:type="ns3:RealTimeSampleArrayMetricDescriptor"> 
					<ns3:Type Code="MDCX_MY_TYPE" CodingSystem="11073" /> <ns3:Unit Code="MDCX_MY_UNIT" 
					CodingSystem="11073" /> </ns3:Metric> -->
			</ns3:Channel>
		</ns3:Vmd>
	</ns3:Mds>
</ns4:MdDescription>
