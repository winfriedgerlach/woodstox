			OperationTarget="handle_context" xsi:type="ns3:SetContextStateOperationDescriptor" 
			/> <ns3:Operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Handle="handle_alert_signal_latching_sco" 
			OperationTarget="handle_alert_signal_latching" xsi:type="ns3:SetAlertStateOperationDescriptor" 
			/> -->
		<ns3:Sco Handle="handle_mds_sco">
			<ns3:Operation
				xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
				Handle="handle_activate" OperationTarget="none"
				xsi:type="ns3:ActivateOperationDescriptor" />
			<ns3:Operation
