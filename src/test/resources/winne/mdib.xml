					<ns3:Unit Code="MDCX_MY_UNIT" CodingSystem="11073" />
				</ns3:Metric>
				<ns3:Metric
					xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
					Handle="string_met" MetricAvailability="Cont"
					MetricCategory="Msrmt" xsi:type="ns3:StringMetricDescriptor">
					<ns3:Type Code="MDCX_MY_TYPE" CodingSystem="11073" />
					<ns3:Unit Code="MDCX_MY_UNIT" CodingSystem="11073" />
				</ns3:Metric>
				<ns3:Metric
					xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
