			<ns3:Manufacturer Lang="en">OR.NET</ns3:Manufacturer>
			<ns3:ModelName Lang="en">SDCLib Demo device</ns3:ModelName>
		</ns3:MetaData>
		<ns3:SystemContext Handle="handle_sc">
			<ns3:PatientContext Handle="h_patient_context" />		
			<ns3:LocationContext Handle="h_location_context" />
			<ns3:WorkflowContext Handle="h_workflow_context" />
		</ns3:SystemContext>
		<ns3:Vmd Handle="handle_vmd">
			<ns3:AlertSystem Handle="handler_alert_system">
				<ns3:Type Code="MDCX_CODE_ID_ALERT_SYSTEM" />
				<ns3:AlertCondition
					xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
					Handle="handle_limit_alert_condition" Kind="Tec" Priority="Me"
					xsi:type="ns3:LimitAlertConditionDescriptor">
					<ns3:Type Code="MDCX_CODE_ID_ALERT_NUMERIC_CONDITION" />
